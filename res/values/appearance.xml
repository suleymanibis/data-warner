        <item name="android:colorAccent">#A6B6FF</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">#10121E</item>
        <item name="android:statusBarColor">#10121E</item>
        <item name="android:navigationBarColor">#191D30</item>
